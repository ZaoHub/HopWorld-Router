#!/bin/bash
# Fixed root actions for the admin service. Arguments are a whitelist.
# shortcut: opens local firewalld/ufw only; cloud security groups stay manual.
set -euo pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export DEBIAN_FRONTEND=noninteractive

if [[ "$(id -u)" -ne 0 ]]; then
  echo "需要 root" >&2
  exit 1
fi

REPO=/opt/hopworld-router
ENV_FILE=/etc/hopworld-router.env

open_port() {
  local proto="$1" port="$2"
  if command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active --quiet firewalld; then
    firewall-cmd --permanent --add-port="${port}/${proto}" >&2
    firewall-cmd --reload >&2
  elif command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q 'Status: active'; then
    ufw --force allow "${port}/${proto}" >&2
  fi
}

install_packages() {
  if command -v apt-get >/dev/null 2>&1; then
    apt-get update -y >&2
    apt-get install -y "$@" >&2
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y "$@" >&2
  elif command -v yum >/dev/null 2>&1; then
    yum install -y "$@" >&2
  else
    echo "无法安装软件包" >&2
    exit 1
  fi
}

write_sudoers() {
  local path="$1" body="$2"
  local tmp
  tmp="$(mktemp)"
  printf '%s\n' "$body" > "$tmp"
  visudo -cf "$tmp" >&2
  install -m 440 "$tmp" "$path"
  rm -f "$tmp"
}

ensure_xray() {
  if [[ -x /usr/local/bin/xray ]] || command -v xray >/dev/null 2>&1; then
    return 0
  fi
  install_packages curl unzip ca-certificates
  bash -c "$(curl -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install >&2
  [[ -x /usr/local/bin/xray ]] || command -v xray >/dev/null 2>&1
}

ensure_acme() {
  local webroot=/var/www/acme certbot_bin
  if ! command -v nginx >/dev/null 2>&1 || ! command -v certbot >/dev/null 2>&1; then
    if command -v yum >/dev/null 2>&1 && ! command -v dnf >/dev/null 2>&1; then
      yum install -y epel-release >&2 || true
      yum install -y nginx certbot >&2 || yum install -y nginx python2-certbot-nginx >&2
    elif command -v apt-get >/dev/null 2>&1; then
      install_packages nginx certbot
    else
      install_packages nginx certbot
    fi
  fi
  certbot_bin="$(command -v certbot || true)"
  if [[ -z "$certbot_bin" ]]; then
    echo "未找到 certbot" >&2
    exit 1
  fi
  install -d -o hopworld-router -g hopworld-router -m 755 "$webroot"
  install -m 644 "$REPO/deploy/hopworld-acme-webroot.conf" /etc/nginx/conf.d/hopworld-acme-webroot.conf
  write_sudoers /etc/sudoers.d/hopworld-router-acme "hopworld-router ALL=(root) NOPASSWD: $certbot_bin"
  touch "$ENV_FILE"
  grep -q '^HOPWORLD_ACME_WEBROOT=' "$ENV_FILE" \
    && sed -i "s|^HOPWORLD_ACME_WEBROOT=.*|HOPWORLD_ACME_WEBROOT=$webroot|" "$ENV_FILE" \
    || echo "HOPWORLD_ACME_WEBROOT=$webroot" >> "$ENV_FILE"
  grep -q '^HOPWORLD_ACME_WRAPPER=' "$ENV_FILE" \
    && sed -i "s|^HOPWORLD_ACME_WRAPPER=.*|HOPWORLD_ACME_WRAPPER=sudo -n $certbot_bin|" "$ENV_FILE" \
    || echo "HOPWORLD_ACME_WRAPPER=sudo -n $certbot_bin" >> "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  systemctl enable nginx >&2
  systemctl restart nginx >&2
  open_port tcp 80
  echo "HOPWORLD_ACME_WEBROOT=$webroot"
  echo "HOPWORLD_ACME_WRAPPER=sudo -n $certbot_bin"
}

ensure_ikev2() {
  if ! command -v swanctl >/dev/null 2>&1 && ! command -v strongswan >/dev/null 2>&1 && ! command -v ipsec >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1; then
      install_packages strongswan strongswan-swanctl
    elif command -v yum >/dev/null 2>&1 && ! command -v dnf >/dev/null 2>&1; then
      yum install -y epel-release >&2 || true
      yum install -y strongswan strongswan-swanctl >&2 || yum install -y strongswan >&2
    else
      install_packages strongswan
    fi
  fi
  install -m 755 "$REPO/deploy/hopworld-ikev2-apply" /usr/local/sbin/hopworld-ikev2-apply
  install -m 755 "$REPO/deploy/hopworld-ikev2-updown" /usr/local/sbin/hopworld-ikev2-updown
  write_sudoers /etc/sudoers.d/hopworld-router-ikev2 \
    'hopworld-router ALL=(root) NOPASSWD: /usr/local/sbin/hopworld-ikev2-apply'
  open_port udp 500
  open_port udp 4500
  if ! systemctl is-enabled hopworld-boot.service >/dev/null 2>&1; then
    bash "$REPO/deploy/hopworld-install-boot.sh" >&2
  fi
}

action="${1:-}"
case "$action" in
  xray) ensure_xray ;;
  open)
    proto="${2:-}"
    port="${3:-}"
    [[ "$proto" == tcp || "$proto" == udp ]] || { echo "协议无效" >&2; exit 1; }
    [[ "$port" =~ ^[0-9]+$ ]] || { echo "端口无效" >&2; exit 1; }
    if (( 10#$port < 1 || 10#$port > 65535 )); then
      echo "端口无效" >&2
      exit 1
    fi
    open_port "$proto" "$port"
    ;;
  acme) ensure_acme ;;
  ikev2) ensure_ikev2 ;;
  *)
    echo "未知操作" >&2
    exit 1
    ;;
esac
