#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
    [ -r /etc/hopworld-router.env ] || {
        echo '缺少 /etc/hopworld-router.env' >&2
        return 1
    }
    procd_open_instance
    procd_set_param command /usr/libexec/hopworld-router
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
