#!/usr/bin/env bash
# Installed as root-owned /usr/local/libexec/hopworld-router-page-update.
set -euo pipefail
umask 022
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0
state=/var/lib/hopworld-router-updates
install -d -m 755 "$state" "$state/venvs" "$state/previous"
job=$(cat /proc/sys/kernel/random/uuid)
old=
release_tag=
write_state() {
  printf '{"state":"%s","id":"%s","current":"%s","target":"%s","timestamp":%s}\n' "$1" "$job" "${old:0:12}" "$release_tag" "$(date +%s)" > "$state/page-status.tmp"
  chmod 644 "$state/page-status.tmp"
  mv -f "$state/page-status.tmp" "$state/page-status.json"
}
trap 'write_state failed' ERR
exec 9>/var/lock/hopworld-router-update.lock
flock -n 9 || { echo 'Another update is running' >&2; exit 1; }
write_state running
cd /opt/hopworld-router
test -d .git && test ! -L .git && test -x .venv/bin/python
service_uid=$(id -u hopworld-router)
test "$(stat -c %u .)" != "$service_uid"
test $((8#$(stat -c %a .) & 022)) = 0
test "$(stat -c %u .git)" = 0
test $((8#$(stat -c %a .git) & 022)) = 0
# Never execute Git hooks or trust a Git configuration writable by the service account.
test "$(stat -c %u .git/config)" = 0
test $((8#$(stat -c %a .git/config) & 022)) = 0
test -z "$(find .git \( -user "$service_uid" -o -perm /022 -o -type l \) -print -quit)"
test -z "$(find .git/hooks -type f ! -name '*.sample' -perm /111 -print -quit 2>/dev/null)"
git() { command git -c core.hooksPath=/dev/null "$@"; }
test "$(git symbolic-ref --short HEAD)" = main
test -z "$(git status --porcelain)"
old=$(git rev-parse HEAD)
test -z "$(find router \( ! -user root -o -perm /022 -o -type l \) -print -quit)"
python=$(readlink -f .venv/bin/python)
test "$(stat -c %u "$python")" = 0
release_tag=$("$python" -I -S -c '
import sys
sys.path.insert(0, "/opt/hopworld-router")
from router.system_update import _json
from router.release_channel import stable_release
release = stable_release(_json)
print(release["tag_name"] if release else "")
')
if test -z "$release_tag"; then write_state complete; exit 0; fi
[[ "$release_tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]
git fetch --no-tags https://github.com/ZaoHub/HopWorld-Router.git "refs/tags/$release_tag"
target=$(git rev-parse 'FETCH_HEAD^{commit}')
declared=$(git show "$target:router/version.py" | sed -n "s/^VERSION = '\([0-9.]\+\)'$/\1/p")
test "v$declared" = "$release_tag"
if git merge-base --is-ancestor "$target" "$old"; then write_state complete; exit 0; fi
test "$(git merge-base "$old" "$target")" = "$old"

backup=$(mktemp -d "$state/backup.XXXXXXXX")
chmod 700 "$backup"
for db in /var/lib/hopworld-router/*.db; do
  test -f "$db" || continue
  sqlite3 "$db" ".backup '$backup/$(basename "$db")'"
done
test ! -f /etc/hopworld-router.env || cp -p /etc/hopworld-router.env "$backup/"
requirements=$(mktemp)
trap 'rm -f "$requirements"; write_state failed' ERR
git show "$target:requirements.txt" > "$requirements"
new_venv=
if ! cmp -s requirements.txt "$requirements"; then
  python=$(readlink -f .venv/bin/python)
  test "$(stat -c %u "$python")" = 0
  new_venv=$(mktemp -d "$state/venvs/venv.XXXXXXXX")
  chmod 755 "$new_venv"
  "$python" -I -m venv "$new_venv"
  "$new_venv/bin/pip" install -r "$requirements"
fi
rm -f "$requirements"
test -z "$(git status --porcelain)"
git merge --ff-only "$target"
if test -n "$new_venv"; then
  previous=$(mktemp -d "$state/previous/venv.XXXXXXXX")
  rmdir "$previous"
  mv .venv "$previous"
  ln -s "$new_venv" .venv
fi
if ! systemctl restart hopworld-router || ! "$python" -I -S -c '
import sys
sys.path.insert(0, "/opt/hopworld-router")
from router.system_update import require_service_ready
require_service_ready()
'; then
  git reset --keep "$old"
  if test -n "$new_venv"; then
    rm .venv
    mv "$previous" .venv
  fi
  systemctl restart hopworld-router || true
  write_state failed
  exit 1
fi
write_state complete
